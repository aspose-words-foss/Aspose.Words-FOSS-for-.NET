	<!-- Release-only: merge the private implementation assemblies into a single Aspose.Words.FOSS.dll
	     with their types internalized, reproducing the single-file layout of the commercial release.
	     SkiaSharp and the other NuGet dependencies stay external. Output goes to bin\Release\merged\<tfm>\
	     and is what the NuGet package will ship; the regular per-TFM output is left untouched. -->
	<Target Name="MergeFossAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' != ''">
		<PropertyGroup>
			<MergedDir>$(ProjectDir)bin\Release\merged\$(TargetFramework)\</MergedDir>
		</PropertyGroup>
		<ItemGroup>
			<MergeInput Include="$(TargetPath)" />
			<MergeInput Include="$(TargetDir)Aspose.Foundation.dll" />
			<MergeInput Include="$(TargetDir)Aspose.JavaAttributes.dll" />
			<MergeInput Include="$(TargetDir)CodePorting.Translator.Cs2Cpp.Control.dll" />
			<MergeInput Include="$(TargetDir)BouncyCastle.Crypto.dll" />
			<_MergeLibDirWithDupes Include="@(ReferencePathWithRefAssemblies->'%(RootDir)%(Directory).')" />
		</ItemGroup>
		<RemoveDuplicates Inputs="@(_MergeLibDirWithDupes)">
			<Output TaskParameter="Filtered" ItemName="_MergeLibDir" />
		</RemoveDuplicates>
		<MakeDir Directories="$(MergedDir)" />
		<Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /internalize /xmldocs /out:&quot;$(MergedDir)$(TargetFileName)&quot; @(MergeInput->'&quot;%(FullPath)&quot;', ' ') @(_MergeLibDir->'/lib:&quot;%(Identity)&quot;', ' ')" />
		<Message Importance="high" Text="Merged FOSS assembly -> $(MergedDir)$(TargetFileName)" />
	</Target>
</Project>
