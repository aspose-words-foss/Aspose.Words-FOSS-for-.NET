<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
		<TargetFrameworkProfile></TargetFrameworkProfile>
		<!-- The FOSS assembly is deliberately named differently from the commercial Aspose.Words.dll;
		     namespaces stay Aspose.Words.* for source compatibility. -->
		<RootNamespace>Aspose.Words</RootNamespace>
		<AssemblyName>Aspose.Words.FOSS</AssemblyName>
		<AssemblyTitle>Aspose.Words FOSS</AssemblyTitle>
		<Configurations>Debug;Release;Test</Configurations>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- Assembly metadata -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>

		<!-- Compiler settings -->
		<LangVersion>7.1</LangVersion>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>
		<CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
		<Optimize>true</Optimize>
		<DebugType>pdbonly</DebugType>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<FileAlignment>4096</FileAlignment>

		<!-- Analyzers and warnings -->
		<RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningLevel>4</WarningLevel>
		<ErrorReport>prompt</ErrorReport>

		<!-- Documentation (per-TFM output; a single fixed path would clash between parallel inner builds) -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Items control: Compile items come from default SDK globbing; resources and None stay explicit -->
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<EnableDefaultNoneItems>false</EnableDefaultNoneItems>

		<!-- Legacy / .NET Framework-specific -->
		<RegisterForComInterop>false</RegisterForComInterop>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<OutputPath>bin\Debug</OutputPath>
		<DefineConstants>TRACE;DEBUG;ASPOSE_WORDS;CODE_ANALYSIS;DEBUG_ASSERT</DefineConstants>
		<NoWarn>CS0659,CS1591,CS2200,CS0618,NU1900</NoWarn>
		<Optimize>false</Optimize>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<OutputPath>bin\Release</OutputPath>
		<DefineConstants>TRACE;ASPOSE_WORDS;OPTIMIZED</DefineConstants>
		<!-- CS0649: with no InternalsVisibleTo (DEBUG-only) the compiler reports internal fields
		     orphaned by the FOSS reduction; same suppression as Foundation and the former net6+ configs. -->
		<NoWarn>CS0659,CS1591,CS0649,NU1900</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Test|AnyCPU'">
		<OutputPath>bin\Test\</OutputPath>
		<DefineConstants>DEBUG;TRACE;ASPOSE_WORDS;CODE_ANALYSIS;OPTIMIZED;DEBUG_ASSERT</DefineConstants>
		<NoWarn>CS0659,CS1591,NU1900</NoWarn>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<!-- Suppressions specific to the net8.0 target (same set the former Release80 configuration used) -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<NoWarn>$(NoWarn);SYSLIB0014;CA1307;CA1309;CA1310;CS0649</NoWarn>
	</PropertyGroup>

