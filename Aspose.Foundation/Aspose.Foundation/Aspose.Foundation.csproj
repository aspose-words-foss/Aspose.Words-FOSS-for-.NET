		<None Include="Collections\Auto\Templates\List.cs" />
		<None Include="Collections\Auto\Templates\Stack.cs" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Common\Nullables.tt">
			<LastGenOutput>Nullables.cs</LastGenOutput>
			<Generator>TextTemplatingFileGenerator</Generator>
		</None>
